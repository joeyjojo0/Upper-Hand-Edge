# Optional: enables the Claude-written NY open brief (the built-in auto brief works without it)
ANTHROPIC_API_KEY=
# Optional: any current Claude model id
ANTHROPIC_MODEL=claude-sonnet-4-5
# Earth View: URL of your God's Eye View deployment
EARTH_VIEW_URL=
# Update page (/update): PIN (8+ characters; falls back to TRADE_PIN), plus ANTHROPIC_API_KEY above
UPDATE_PIN=
# Fine-grained GitHub token for this repo: Contents + Actions read/write, Workflows read/write, Commit statuses read
GITHUB_TOKEN=
# Optional: default Claude model for the update page
UPDATE_MODEL=claude-sonnet-5-5
